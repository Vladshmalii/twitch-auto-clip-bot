### 4. Multi-Signal Aggregator

```python
class MultiSignalAggregator:
    def __init__(self):
        self.weights = {
            'chat_velocity': 0.4,
            'audio_rms': 0.3,
            'audio_onsets': 0.1,
            'motion_score': 0.15,
            'keywords': 0.05
        }

    def calculate_score(self, signals: dict) -> float:
        # Normalize each signal to 0-1
        chat_score = min(signals['chat_velocity'] / 100, 1.0)
        audio_score = min(signals['audio_rms'] * 10, 1.0)
        motion_score = min(signals['motion_score'] / 10000, 1.0)

        # Weighted sum
        final = (
            chat_score * self.weights['chat_velocity'] +
            audio_score * self.weights['audio_rms'] +
            motion_score * self.weights['motion_score']
        )

        return final

    def should_create_clip(self, score: float) -> bool:
        return score > 0.7  # 70% threshold
```

